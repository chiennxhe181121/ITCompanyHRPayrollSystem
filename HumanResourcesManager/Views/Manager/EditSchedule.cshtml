@model HumanResourcesManager.BLL.DTOs.Manager.OTScheduleCreateDTO
@{
    ViewData["Title"] = "Chỉnh Sửa Lịch Tăng Ca";
    ViewData["PageTitle"] = "Chỉnh Sửa Lịch Tăng Ca";
    ViewData["PageSubtitle"] = "Cập nhật thông tin lịch tăng ca";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
    var scheduleId = ViewBag.ScheduleId;
    
    // Sử dụng thời gian hệ thống mặc định
    var now = DateTime.Now;
    
    var firstOccurrenceStart = Model.StartDate.Date.Add(Model.StartTime);
    // 1. Khóa Ngày bắt đầu nếu phiên đầu tiên đã diễn ra
    var isExpiredSchedule = Model.Status == 3 || Model.Status == 1;
    var isLockDate = isExpiredSchedule || now >= firstOccurrenceStart;
    
    // 2. Khóa Giờ: Xác định phiên tiếp theo (Hôm nay hoặc Ngày mai)
    DateTime nextStart;
    var todayStart = now.Date.Add(Model.StartTime);
    if (now < todayStart.AddHours(-1)) {
        nextStart = todayStart;
    } else {
        nextStart = now.Date.AddDays(1).Add(Model.StartTime);
    }
    
    // Với lịch đã hết hạn: cho phép sửa giờ bắt đầu/kết thúc tự do (chỉ cần StartTime < EndTime)
    var isLockTime = !isExpiredSchedule && now >= nextStart.AddHours(-1);
}

@await Html.PartialAsync("_ManagerHeader")

<div class="p-5 lg:p-8 bg-slate-50/50 min-h-screen">
    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
            <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <div>
                    <h2 class="text-xl font-black text-slate-800 tracking-tight">Chỉnh Sửa Lịch OT #@scheduleId</h2>
                    <p class="text-sm text-slate-500 mt-1 font-medium italic">
                        Trạng thái: 
                        @if (Model.Status == 5) { <span class="text-indigo-600 font-bold">Sắp tới</span> }
                        else if (Model.Status == 0) { <span class="text-emerald-600 font-bold">Đang hoạt động</span> }
                        else if (Model.Status == 3 || Model.Status == 1) { <span class="text-amber-600 font-bold">Đã hết hạn</span> }
                    </p>
                </div>
                <a href="/HumanResourcesManager/manager/schedule" class="group flex items-center text-sm font-bold text-slate-400 hover:text-slate-800 transition-all">
                    <svg class="w-4 h-4 mr-1.5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Quay lại
                </a>
            </div>

            <div class="p-8 md:p-10">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-8 p-4 rounded-2xl bg-red-50 text-red-600 border border-red-100 flex items-start gap-3">
                        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <div asp-validation-summary="All" class="text-sm font-bold"></div>
                    </div>
                }

                @if (isLockDate || isLockTime)
                {
                    <div class="mb-10 p-5 rounded-3xl bg-amber-50 border border-amber-200/60 flex items-start gap-5 shadow-sm shadow-amber-200/20">
                        <div class="p-3 bg-white rounded-2xl text-amber-500 shadow-sm border border-amber-100">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v3m0-3h3m-3 0H9m12-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-black text-amber-900 uppercase tracking-widest">Thông tin bị khóa một phần</h4>
                            <p class="text-xs text-amber-700/80 mt-1.5 leading-relaxed font-medium">
                                @if (isLockDate && isLockTime) {
                                    <span>Lịch đã bắt đầu phiên đầu tiên. <b>Ngày bắt đầu</b> đã được giữ cố định. <b>Khung giờ OT</b> cũng bị khóa do chưa đến thời điểm cho phép sửa phiên tiếp theo (phải sửa trước ít nhất 1 tiếng).</span>
                                } else if (isLockDate) {
                                    <span>Phiên OT đầu tiên đã diễn ra. <b>Ngày bắt đầu</b> đã bị khóa. Bạn vẫn có thể sửa <b>Khung giờ</b> cho các phiên tiếp theo nếu thực hiện trước giờ bắt đầu của chúng ít nhất 1 tiếng.</span>
                                } else if (isLockTime) {
                                    <span><b>Khung giờ</b> hiện đang bị khóa vì quá gần phiên OT sắp tới (cần sửa trước 1 tiếng). Bạn vẫn có thể sửa <b>Ngày bắt đầu</b> vì chưa tới ngày diễn ra phiên đầu tiên.</span>
                                }
                            </p>
                        </div>
                    </div>
                }

                <form asp-action="EditSchedule" asp-controller="Manager" asp-route-id="@scheduleId" method="post" class="space-y-8">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2 md:col-span-2">
                            <label asp-for="Name" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                Tên Lịch OT <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="Name" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-slate-50/30" placeholder="VD: OT Dự án Tháng 3" />
                            <span asp-validation-for="Name" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2 md:col-span-2">
                            <label asp-for="Description" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                                Mô tả nội dung công việc
                            </label>
                            <textarea asp-for="Description" rows="4" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" placeholder="Mục tiêu OT, các Task cần hoàn thành..."></textarea>
                            <span asp-validation-for="Description" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="Quantity" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5V4H2v16h5m10 0v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5m10 0H7"></path></svg>
                                Số lượng nhân sự <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="Quantity" type="number" min="1" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-slate-50/30" />
                            <span asp-validation-for="Quantity" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>
                        
                        <div class="space-y-2"></div>

                        <div class="space-y-2">
                            <label asp-for="StartDate" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Ngày bắt đầu <span class="text-red-500 ml-1">*</span>
                            </label>
                            @if (isLockDate)
                            {
                                <div class="relative group">
                                    <input asp-for="StartDate" type="date" class="w-full px-5 py-3.5 rounded-2xl border border-slate-100 bg-slate-100 text-slate-400 cursor-not-allowed outline-none text-sm font-bold shadow-inner" readonly />
                                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity">
                                        <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="StartDate" />
                            }
                            else
                            {
                                <input asp-for="StartDate" type="date" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-slate-50/30" />
                            }
                            <span asp-validation-for="StartDate" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="EndDate" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Ngày kết thúc <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="EndDate" type="date" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-white" />
                            <span asp-validation-for="EndDate" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="StartTime" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Giờ bắt đầu <span class="text-red-500 ml-1">*</span>
                            </label>
                            @if (isLockTime)
                            {
                                <div class="relative group">
                                    <input asp-for="StartTime" type="time" class="w-full px-5 py-3.5 rounded-2xl border border-slate-100 bg-slate-100 text-slate-400 cursor-not-allowed outline-none text-sm font-bold shadow-inner" readonly />
                                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity">
                                        <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="StartTime" />
                            }
                            else
                            {
                                <input asp-for="StartTime" type="time" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-slate-50/30" />
                            }
                            <span asp-validation-for="StartTime" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="EndTime" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Giờ kết thúc <span class="text-red-500 ml-1">*</span>
                            </label>
                            @if (isLockTime)
                            {
                                <div class="relative group">
                                    <input asp-for="EndTime" type="time" class="w-full px-5 py-3.5 rounded-2xl border border-slate-100 bg-slate-100 text-slate-400 cursor-not-allowed outline-none text-sm font-bold shadow-inner" readonly />
                                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity">
                                        <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                                    </div>
                                </div>
                                <input type="hidden" asp-for="EndTime" />
                            }
                            else
                            {
                                <input asp-for="EndTime" type="time" class="w-full px-5 py-3.5 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-bold bg-white" />
                            }
                            <span asp-validation-for="EndTime" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>
                    </div>

                    <div class="pt-10 border-t border-slate-100 flex items-center justify-end gap-3">
                        <a href="/HumanResourcesManager/manager/schedule" class="px-6 py-3 rounded-2xl text-sm font-bold text-slate-500 hover:bg-slate-100 transition-all uppercase tracking-widest">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-sm font-bold transition-all shadow-lg shadow-blue-500/25 active:scale-95 uppercase tracking-widest">
                            Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
