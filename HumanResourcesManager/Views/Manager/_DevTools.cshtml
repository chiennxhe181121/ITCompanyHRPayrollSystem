<!-- Developer Tools (Extra Data Generation) -->
<div class="mt-8 p-6 bg-amber-50 rounded-2xl border border-amber-200/60 shadow-sm mx-5 lg:mx-8 mb-8">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
        </div>
        <div>
            <h3 class="text-lg font-semibold text-amber-900">Công cụ hỗ trợ Kiểm thử</h3>
            <p class="text-amber-700/80 text-sm">Chỉ hiển thị trong quá trình phát triển để chuẩn bị dữ liệu test cho nhiều phòng ban và manager.</p>
        </div>
    </div>
    
    <form action="/HumanResourcesManager/manager/generate-test-data" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="inline-flex items-center px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-xl transition-all shadow-sm hover:shadow-md focus:ring-4 focus:ring-amber-200">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Sinh dữ liệu mẫu số lượng lớn
        </button>
        <p class="mt-3 text-xs text-amber-600/70 italic">
            * Hành động này sẽ tạo thêm phòng ban mới, manager mới, nhân viên mới và hàng trăm lịch/đăng ký OT.
        </p>
    </form>
</div>
