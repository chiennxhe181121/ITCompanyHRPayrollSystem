@model HumanResourcesManager.BLL.DTOs.Manager.OTScheduleCreateDTO
@{
    ViewData["Title"] = "Thêm Lịch Tăng Ca";
    ViewData["PageTitle"] = "Thêm Lịch Tăng Ca";
    ViewData["PageSubtitle"] = "Tạo một lịch tăng ca mới cho phòng ban của bạn";
    Layout = "~/Views/Manager/_ManagerLayout.cshtml";
}

@await Html.PartialAsync("_ManagerHeader")

<div class="p-5 lg:p-8 bg-slate-50/50 min-h-screen">
    <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <div>
                    <h2 class="text-lg font-semibold text-slate-800">Thông tin Lịch OT</h2>
                    <p class="text-sm text-slate-500 mt-0.5">Vui lòng điền các thông tin cần thiết</p>
                </div>
                <a href="/HumanResourcesManager/manager/schedule" class="text-sm font-medium text-slate-500 hover:text-slate-700">
                    &larr; Quay lại
                </a>
            </div>

            <div class="p-6 md:p-8">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 rounded-xl bg-red-50 text-red-600 border border-red-100">
                        <div asp-validation-summary="All" class="text-sm"></div>
                    </div>
                }

                <form asp-action="CreateSchedule" asp-controller="Manager" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 md:col-span-2">
                            <label asp-for="Name" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                Tên Lịch OT <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="Name" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" placeholder="VD: OT Dự án Tháng 3" />
                            <span asp-validation-for="Name" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2 md:col-span-2">
                            <label asp-for="Description" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                                Mô tả chi tiết
                            </label>
                            <textarea asp-for="Description" rows="3" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" placeholder="Nội dung công việc cần tăng ca..."></textarea>
                            <span asp-validation-for="Description" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="Quantity" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5V4H2v16h5m10 0v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5m10 0H7"></path></svg>
                                Số lượng nhân sự <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="Quantity" type="number" min="1" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" />
                            <span asp-validation-for="Quantity" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <div class="space-y-2"></div>

                        <div class="space-y-2">
                            <label asp-for="StartDate" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Ngày bắt đầu <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="StartDate" type="date" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" />
                            <span asp-validation-for="StartDate" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                        </div>

                        <input asp-for="EndDate" type="hidden" id="EndDate" />

                        <div class="space-y-2">
                            <label asp-for="StartTime" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Giờ bắt đầu <span class="text-red-500 ml-1">*</span>
                            </label>
                            <input asp-for="StartTime" type="time" step="1800" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30" />
                            <span asp-validation-for="StartTime" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                            <p class="text-xs text-slate-500">Ngày thường từ 19:30, Thứ 7/CN từ 08:00, ca OT kết thúc không quá 02:00 sáng hôm sau.</p>
                        </div>

                        <div class="space-y-2">
                            <label asp-for="DurationHours" class="flex items-center text-sm font-bold text-slate-700">
                                <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Số giờ OT <span class="text-red-500 ml-1">*</span>
                            </label>
                            <select asp-for="DurationHours" id="otDurationHours" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium bg-slate-50/30">
                                <option value="1">1 tiếng</option>
                                <option value="2">2 tiếng</option>
                                <option value="3">3 tiếng</option>
                                <option value="4">4 tiếng</option>
                                <option value="5">5 tiếng</option>
                                <option value="6">6 tiếng</option>
                                <option value="7">7 tiếng</option>
                                <option value="8">8 tiếng</option>
                            </select>
                            <span asp-validation-for="DurationHours" class="text-[10px] text-red-500 font-bold uppercase tracking-tight"></span>
                            <input asp-for="EndTime" type="hidden" id="otEndTimeHidden" />
                            <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                                <p class="text-xs text-slate-500">Thời gian kết thúc dự kiến</p>
                                <p id="otComputedEndDisplay" class="text-sm font-semibold text-slate-700 mt-0.5">--</p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-8 border-t border-slate-100 flex items-center justify-end gap-3">
                        <a href="/HumanResourcesManager/manager/schedule" class="px-6 py-3 rounded-2xl text-sm font-bold text-slate-500 hover:bg-slate-100 transition-all uppercase tracking-widest">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-sm font-bold transition-all shadow-lg shadow-blue-500/25 active:scale-95 uppercase tracking-widest">
                            Tạo Lịch OT
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const startDateInput = document.getElementById("StartDate");
            const startTimeInput = document.getElementById("StartTime");
            const endDateInput = document.getElementById("EndDate");
            const durationSelect = document.getElementById("otDurationHours");
            const endTimeHidden = document.getElementById("otEndTimeHidden");
            const endDisplay = document.getElementById("otComputedEndDisplay");

            if (!startDateInput || !startTimeInput || !durationSelect || !endTimeHidden || !endDisplay) return;

            function isWeekend(date) {
                const day = date.getDay();
                return day === 0 || day === 6;
            }

            function pad2(v) {
                return String(v).padStart(2, "0");
            }

            function syncEndDate() {
                if (!startDateInput.value || !endDateInput) return;
                endDateInput.value = startDateInput.value;
            }

            function updateDurationOptions() {
                if (!startDateInput.value) return;
                const selectedDate = new Date(`${startDateInput.value}T00:00:00`);
                const maxHours = isWeekend(selectedDate) ? 8 : 4;
                for (const opt of durationSelect.options) {
                    const h = Number(opt.value);
                    opt.disabled = h > maxHours;
                }
                if (Number(durationSelect.value) > maxHours) {
                    durationSelect.value = String(maxHours);
                }
            }

            function formatDdMmYyyy(d) {
                return `${pad2(d.getDate())}/${pad2(d.getMonth() + 1)}/${d.getFullYear()}`;
            }

            function updateComputedEnd() {
                if (!startDateInput.value || !startTimeInput.value) {
                    endDisplay.textContent = "--";
                    endTimeHidden.value = "";
                    return;
                }

                const [h, m] = startTimeInput.value.split(":").map(Number);
                const duration = Number(durationSelect.value || "1");
                const startDate = new Date(`${startDateInput.value}T00:00:00`);
                const endDate = new Date(startDate);
                endDate.setHours(h, m, 0, 0);
                endDate.setHours(endDate.getHours() + duration);

                const crossesMidnight = endDate.getFullYear() !== startDate.getFullYear()
                    || endDate.getMonth() !== startDate.getMonth()
                    || endDate.getDate() !== startDate.getDate();
                endTimeHidden.value = `${pad2(endDate.getHours())}:${pad2(endDate.getMinutes())}:00`;
                const hm = `${pad2(endDate.getHours())}:${pad2(endDate.getMinutes())}`;
                if (crossesMidnight) {
                    endDisplay.textContent = `${hm} · ${formatDdMmYyyy(endDate)} — kết thúc sang ngày mới`;
                } else {
                    endDisplay.textContent = hm;
                }
            }

            startDateInput.addEventListener("change", () => {
                syncEndDate();
                updateDurationOptions();
                updateComputedEnd();
            });
            startTimeInput.addEventListener("change", updateComputedEnd);
            durationSelect.addEventListener("change", updateComputedEnd);

            updateDurationOptions();
            updateComputedEnd();
        })();
    </script>
}
