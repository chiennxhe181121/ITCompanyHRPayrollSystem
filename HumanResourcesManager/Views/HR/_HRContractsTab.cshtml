<div id="contractsTab" class="tab-content hidden">
    <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-800">Hợp Đồng</h2>
                <p class="text-sm text-slate-500 mt-0.5">Tạo / cập nhật hợp đồng nhân viên</p>
            </div>
            <button type="button" id="addContractBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2.5 rounded-xl shadow-sm transition-colors text-sm">+ Thêm hợp đồng</button>
        </div>
    </div>
    <div class="p-6">
        <div class="overflow-x-auto rounded-xl border border-slate-200/80">
            <table class="employee-table w-full">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Nhân viên</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Loại</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Từ ngày</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Đến ngày</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Lương cơ bản</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Hiệu lực</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Hành động</th>
                    </tr>
                </thead>
                <tbody id="contractsTableBody"></tbody>
            </table>
        </div>
        <div id="contractsPagination" class="pagination mt-6"></div>
    </div>
</div>
