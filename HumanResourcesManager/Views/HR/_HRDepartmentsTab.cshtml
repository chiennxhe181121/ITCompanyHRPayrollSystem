@using HumanResourcesManager.BLL.DTOs
@model List<ContractDTO>

<div class="p-6">

    <!-- HEADER -->
    <div class="mb-6">
        <h2 class="text-xl font-semibold text-slate-800">Hợp Đồng</h2>
        <p class="text-sm text-slate-500">
            Tổng số hợp đồng: <strong>@ViewBag.TotalRecords</strong>
        </p>
    </div>

    <!-- TABLE -->
    <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="py-3 px-4 text-left">Nhân viên</th>
                    <th class="py-3 px-4 text-left">Loại</th>
                    <th class="py-3 px-4 text-left">Từ ngày</th>
                    <th class="py-3 px-4 text-left">Đến ngày</th>
                    <th class="py-3 px-4 text-left">Lương</th>
                    <th class="py-3 px-4 text-left">Trạng thái</th>
                    <th class="py-3 px-4 text-left">Hành động</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="py-3 px-4">@c.EmployeeName</td>
                            <td class="py-3 px-4">@c.ContractType</td>
                            <td class="py-3 px-4">@c.StartDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 px-4">
                                @(c.EndDate.HasValue ? c.EndDate.Value.ToString("dd/MM/yyyy") : "-")
                            </td>
                            <td class="py-3 px-4">
                                @String.Format("{0:N0} đ", c.BasicSalary)
                            </td>
                            <td class="py-3 px-4">
                                @if (c.IsActive)
                                {
                                    <span class="px-2 py-1 text-xs bg-green-100 text-green-700 rounded-lg">
                                        Đang hiệu lực
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 text-xs bg-red-100 text-red-600 rounded-lg">
                                        Hết hiệu lực
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4">
                                <a asp-controller="Contracts"
                                   asp-action="Delete"
                                   asp-route-id="@c.ContractId"
                                   class="text-red-600 hover:underline text-sm">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-6 text-slate-400">
                            ⚠ Không có dữ liệu hợp đồng
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="mt-6 flex gap-2">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-controller="Contracts"
               asp-action="Index"
               asp-route-page="@i"
               class="px-3 py-1 rounded-lg border text-sm
               @(i == ViewBag.CurrentPage ? "bg-blue-600 text-white" : "bg-white")">
                @i
            </a>
        }
    </div>

</div>