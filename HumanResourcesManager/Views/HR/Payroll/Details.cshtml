@using HumanResourcesManager.BLL.DTOs
@model PayrollDTO

@{
    ViewData["Title"] = "Chi tiết lương";
    Layout = "~/Views/HR/_HRLayout.cshtml";
}

<div class="px-8 py-6 bg-white border-b border-slate-100 shadow-sm flex justify-between items-center">
    <h2 class="text-2xl font-extrabold text-slate-800 flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-lg">
            <i class="fa-solid fa-money-bill-wave"></i>
        </span>
        Chi tiết lương
    </h2>
    <a asp-action="ExportPdf"
       asp-route-payrollId="@Model.PayrollId"
       asp-route-month="@Model.Month"
       asp-route-year="@Model.Year"
       class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700">
        Xuất PDF
    </a>
</div>

<div class="p-8 bg-slate-100 min-h-screen">

    <!-- THÔNG TIN -->
    <div class="mb-6">
        <p><b>Nhân viên:</b> @Model.EmployeeName</p>
        <p><b>Tháng/Năm:</b> @Model.Month/@Model.Year</p>
    </div>

    <!-- CHI TIẾT LƯƠNG -->
    <h3 class="text-lg font-bold mb-2">Chi tiết thu nhập & khấu trừ</h3>

    <div class="bg-white rounded-xl shadow p-4 mb-6">
        <table class="w-full text-sm text-left border-collapse">
            <thead>
                <tr class="border-b">
                    <th class="py-2">Mô tả</th>
                    <th class="py-2 text-right">Số tiền</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.PayrollDetails != null && Model.PayrollDetails.Any())
                {
                    foreach (var item in Model.PayrollDetails)
                    {
                        var isDeduction = item.Type.ToString() == "Deduction";

                        <tr class="border-b hover:bg-slate-50">
                            <td class="py-2">@item.Description</td>

                            <td class="py-2 text-right font-semibold @(isDeduction ? "text-red-600" : "text-green-700")">
                                @(isDeduction ? "-" : "+")@item.Amount.ToString("N0") VND
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center text-gray-500 py-4">
                            Không có dữ liệu chi tiết lương
                        </td>
                    </tr>
                }

                <!-- TỔNG LƯƠNG -->
                <tr>
                    <td class="font-bold text-lg pt-3">Lương thực nhận</td>
                    <td class="text-right font-bold text-green-700 text-lg pt-3">
                        @Model.NetSalary.ToString("N0") VND
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <a asp-action="Index" class="bg-gray-200 px-4 py-2 rounded-lg hover:bg-gray-300 transition-all">
        Quay lại danh sách
    </a>
</div>