@using HumanResourcesManager.BLL.DTOs
@model List<PayrollDTO>

@{
    ViewData["Title"] = "Danh sách lương";
    Layout = "~/Views/HR/_HRLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    int stt = (currentPage - 1) * pageSize;
    string search = ViewBag.Search ?? "";
}

<div class="px-8 py-6 bg-white border-b border-slate-100 shadow-sm flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-800 flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-green-500 to-emerald-600 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-money-bill-wave"></i>
            </span>
            Quản lý bảng lương
        </h2>
        <p class="text-sm text-slate-500 mt-1 ml-14">
            Tổng số bản ghi: <strong>@ViewBag.TotalRecords</strong>
        </p>
    </div>

    <a href="@Url.Action("Create")"
       class="inline-flex items-center gap-2 bg-slate-900 hover:bg-green-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition-all shadow-md">
        <i class="fa-solid fa-plus"></i>
        Tạo bảng lương
    </a>
</div>

<div class="p-8 bg-slate-100 min-h-screen">

    <!-- TÌM KIẾM -->
    <form method="get" asp-action="Index" class="mb-6 flex gap-4 items-center">
        <input type="text" name="search" value="@search" placeholder="Tìm theo nhân viên..."
               class="px-4 py-2 border rounded-lg w-64 text-sm" />
        <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm">
            Tìm kiếm
        </button>
    </form>

    <!-- BẢNG LƯƠNG -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-slate-600 uppercase text-xs font-bold border-b">
                    <tr>
                        <th class="px-6 py-4 text-center w-16">STT</th>
                        <th class="px-6 py-4">Nhân viên</th>
                        <th class="px-6 py-4">Tháng/Năm</th>
                        <th class="px-6 py-4">Lương thực nhận</th>
                        <th class="px-6 py-4 text-right">Hành động</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr class="hover:bg-green-50 transition-colors">

                                <td class="px-6 py-4 text-center text-slate-400">
                                    @(++stt)
                                </td>

                                <td class="px-6 py-4 font-semibold text-slate-700">
                                    @p.EmployeeName
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @p.Month/@p.Year
                                </td>

                                <td class="px-6 py-4 text-emerald-700 font-bold">
                                    @p.NetSalary.ToString("N0") VNĐ
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end items-center gap-2">

                                        <a href="@Url.Action("Edit", new { id = p.PayrollId })"
                                           class="flex items-center justify-center w-9 h-9 rounded-xl
                                           bg-blue-50 border border-blue-200 text-blue-600
                                           hover:bg-blue-600 hover:text-white transition-all">
                                            <i class="fa-solid fa-pen text-sm"></i>
                                        </a>

                                        <a href="@Url.Action("Details", new { id = p.PayrollId })"
                                           class="flex items-center justify-center w-9 h-9 rounded-xl
                                           bg-yellow-50 border border-yellow-200 text-yellow-600
                                           hover:bg-yellow-600 hover:text-white transition-all">
                                            <i class="fa-solid fa-eye text-sm"></i>
                                        </a>


                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-6 text-slate-400">
                                Không có bản ghi bảng lương
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PHÂN TRANG -->
    @if (totalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 mt-6">
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="px-3 py-1 rounded-lg bg-green-600 text-white font-bold">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Index", new { page = i, pageSize = pageSize, search = search })"
                       class="px-3 py-1 rounded-lg bg-white border hover:bg-green-600 hover:text-white">@i</a>
                }
            }
        </div>
    }
</div>



<script>
    let payrollIdToDelete = 0;
    const modal = document.getElementById("confirmModal");
    const confirmBtn = document.getElementById("confirmDelete");
    const cancelBtn = document.getElementById("cancelDelete");

    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            payrollIdToDelete = this.getAttribute("data-id");
            modal.style.display = "flex";
        });
    });

    cancelBtn.addEventListener("click", () => modal.style.display = "none");
    modal.addEventListener("click", e => { if(e.target === modal) modal.style.display = "none"; });


</script>