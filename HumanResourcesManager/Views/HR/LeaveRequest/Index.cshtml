@model List<LeaveRequestDTO>
@using HumanResourcesManager.DAL.Enum

@{
    ViewData["Title"] = "Quản lý đơn xin nghỉ";
    Layout = "~/Views/HR/_HRLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    int stt = (currentPage - 1) * pageSize;
    string search = ViewBag.Search ?? "";
}

<!-- HEADER -->
<div class="px-8 py-6 bg-white border-b border-slate-100 shadow-sm flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-800 flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-500 to-red-500 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-calendar-check"></i>
            </span>
            Quản lý đơn xin nghỉ
        </h2>
        <p class="text-sm text-slate-500 mt-1 ml-14">
            Tổng số đơn: <strong>@ViewBag.TotalRecords</strong>
        </p>
    </div>
</div>

<div class="p-8 bg-slate-100 min-h-screen">

    <!-- SEARCH -->
    <form method="get" asp-action="Index" class="mb-6 flex gap-4 items-center">

        <input type="text" name="search" value="@search" placeholder="Tìm theo tên nhân viên..."
               class="px-4 py-2 border rounded-lg w-64 text-sm" />

        <select name="status" class="px-4 py-2 border rounded-lg text-sm">
            <option value="">Tất cả trạng thái</option>
            <option value="0" selected="@(ViewBag.Status == RequestStatus.Pending)">Chờ duyệt</option>
            <option value="1" selected="@(ViewBag.Status == RequestStatus.Approved)">Đã duyệt</option>
            <option value="2" selected="@(ViewBag.Status == RequestStatus.Rejected)">Từ chối</option>
        </select>

        <button type="submit" class="bg-orange-600 text-white px-4 py-2 rounded-lg text-sm">
            Tìm kiếm
        </button>

    </form>

    <!-- TABLE -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-slate-600 uppercase text-xs font-bold border-b">
                    <tr>
                        <th class="px-6 py-4 text-center w-16">STT</th>
                        <th class="px-6 py-4">Nhân viên</th>
                        <th class="px-6 py-4">Loại nghỉ</th>
                        <th class="px-6 py-4">Từ ngày</th>
                        <th class="px-6 py-4">Đến ngày</th>
                        <th class="px-6 py-4">Trạng thái</th>
                        <th class="px-6 py-4 text-right">Hành động</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-orange-50 transition-colors">

                                <td class="px-6 py-4 text-center text-slate-400">
                                    @(++stt)
                                </td>

                                <td class="px-6 py-4 font-semibold text-slate-700">
                                    @item.EmployeeName
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @item.LeaveTypeName
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @item.FromDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @item.ToDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded-lg text-xs font-bold
                                        @(item.Status == RequestStatus.Pending ? "bg-yellow-100 text-yellow-700" :
                                          item.Status == RequestStatus.Approved ? "bg-green-100 text-green-700" :
                                          "bg-red-100 text-red-700")">
                                        @(item.Status == RequestStatus.Pending ? "Chờ duyệt" :
                                            item.Status == RequestStatus.Approved ? "Đã duyệt" :
                                            "Từ chối")
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    @if (item.Status == RequestStatus.Pending)
                                    {
                                        <div class="flex justify-end gap-2">

                                            <!-- APPROVE -->
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden" name="leaveRequestId" value="@item.LeaveRequestId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        title="Duyệt"
                                                        class="flex items-center justify-center w-9 h-9 rounded-xl
                                                        bg-green-50 border border-green-200 text-green-600
                                                        hover:bg-green-600 hover:text-white transition-all">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>

                                            <!-- REJECT -->
                                            <form asp-action="Reject" method="post">
                                                <input type="hidden" name="leaveRequestId" value="@item.LeaveRequestId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        title="Từ chối"
                                                        class="flex items-center justify-center w-9 h-9 rounded-xl
                                                        bg-red-50 border border-red-200 text-red-600
                                                        hover:bg-red-600 hover:text-white transition-all">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            </form>

                                        </div>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-6 text-slate-400">
                                Không có đơn xin nghỉ nào
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (totalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 mt-6">
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="px-3 py-1 rounded-lg bg-orange-600 text-white font-bold">@i</span>
                }
                else
                {
                    <a href="@Url.Action("Index", new { page = i, search = search })"
                       class="px-3 py-1 rounded-lg bg-white border hover:bg-orange-600 hover:text-white">
                        @i
                    </a>
                }
            }
        </div>
    }
</div>