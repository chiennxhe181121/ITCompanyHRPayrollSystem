@model HumanResourcesManager.BLL.DTOs.ContractDTO

@{
    ViewData["Title"] = "Tạo Hợp Đồng";
    Layout = "~/Views/HR/_HRLayout.cshtml";
}

<header class="bg-white border-b px-6 py-5">
    <h1 class="text-2xl font-semibold text-slate-800">
        Tạo Hợp Đồng Mới
    </h1>
</header>

<div class="p-8">
    <form asp-action="Create" method="post"
          class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-6">

        <div asp-validation-summary="All"
             class="text-red-500 text-sm"></div>

        <!-- Nhân viên -->
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
                Nhân viên
            </label>

            <select asp-for="EmployeeId"
                    asp-items="Model.Employees"
                    class="w-full border rounded-lg px-3 py-2">
                <option value="">-- Chọn nhân viên --</option>
            </select>

            <span asp-validation-for="EmployeeId"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Loại hợp đồng -->
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
                Loại hợp đồng
            </label>

            <select asp-for="ContractType"
                    class="w-full border rounded-lg px-3 py-2">

                <option value="">-- Chọn loại hợp đồng --</option>
                <option value="FullTime">Toàn thời gian</option>
                <option value="PartTime">Bán thời gian</option>
                <option value="Official">Chính thức</option>
                <option value="Intern">Thực tập</option>

            </select>

            <span asp-validation-for="ContractType"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Ngày bắt đầu -->
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
                Ngày bắt đầu
            </label>

            <input asp-for="StartDate" type="date"
                   class="w-full border rounded-lg px-3 py-2" />

            <span asp-validation-for="StartDate"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Ngày kết thúc -->
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
                Ngày kết thúc
            </label>

            <input asp-for="EndDate" type="date"
                   class="w-full border rounded-lg px-3 py-2" />

            <span asp-validation-for="EndDate"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Lương -->
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
                Lương cơ bản
            </label>

            <input asp-for="BasicSalary" type="number"
                   class="w-full border rounded-lg px-3 py-2" />

            <span asp-validation-for="BasicSalary"
                  class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-end gap-3">
            <a href="@Url.Action("Index","Contracts")"
               class="px-4 py-2 rounded-lg bg-slate-200 hover:bg-slate-300">
                Hủy
            </a>

            <button type="submit"
                    class="px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700">
                Lưu
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}