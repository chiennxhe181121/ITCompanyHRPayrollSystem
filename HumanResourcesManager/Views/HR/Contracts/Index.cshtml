@using HumanResourcesManager.BLL.DTOs
@model List<ContractDTO>

@{
    ViewData["Title"] = "Quản lý Hợp Đồng";
    Layout = "~/Views/HR/_HRLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;

    // TEST 1 RECORD / 1 PAGE
    int pageSize = 1;

    int totalPages = ViewBag.TotalPages ?? 1;
    bool isActive = ViewBag.IsActive ?? true;

    int stt = (currentPage - 1) * pageSize;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="px-8 py-6 bg-white border-b border-slate-100 shadow-sm flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-800 flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-file-contract"></i>
            </span>
            Quản Lý Hợp Đồng
        </h2>
        <p class="text-sm text-slate-500 mt-1 ml-14">
            Tổng số hợp đồng: <strong>@ViewBag.TotalRecords</strong>
        </p>
    </div>

    <a href="/Contracts/Create"
       class="inline-flex items-center gap-2 bg-slate-900 hover:bg-blue-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition-all shadow-md">
        <i class="fa-solid fa-plus"></i>
        Tạo Hợp Đồng
    </a>
</div>

<div class="p-8 bg-slate-100 min-h-screen">

    <!-- Tabs -->
    <div class="flex gap-4 mb-6">

        <a href="@Url.Action("Index", new {
            isActive = true,
            pageSize = pageSize,
            search = ViewBag.Search,
            contractType = ViewBag.ContractType
        })"
           class="px-4 py-2 rounded-lg text-sm font-bold
       @(isActive ? "bg-blue-600 text-white" : "bg-white border text-slate-600")">
            Còn hiệu lực
        </a>

        <a href="@Url.Action("Index", new {
            isActive = false,
            pageSize = pageSize,
            search = ViewBag.Search,
            contractType = ViewBag.ContractType
        })"
           class="px-4 py-2 rounded-lg text-sm font-bold
       @(!isActive ? "bg-blue-600 text-white" : "bg-white border text-slate-600")">
            Hết hiệu lực
        </a>

    </div>

    <form method="get" asp-action="Index" class="mb-6 flex gap-4 items-center">

        <input type="hidden"
               name="isActive"
               value="@ViewBag.IsActive.ToString().ToLower()" />
        <input type="hidden" name="pageSize" value="@pageSize" />

        <!-- Search -->
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Tìm theo tên nhân viên..."
               class="px-4 py-2 border rounded-lg w-64 text-sm" />

        <!-- Filter loại hợp đồng -->
        <select name="contractType"
                class="px-4 py-2 border rounded-lg text-sm">

            <option value="">-- Tất cả loại --</option>
            <option value="Thử việc"
                    selected="@(ViewBag.ContractType == "Thử việc")">
                Thử việc
            </option>
            <option value="Chính thức"
                    selected="@(ViewBag.ContractType == "Chính thức")">
                Chính thức
            </option>
            <option value="Thời vụ"
                    selected="@(ViewBag.ContractType == "Thời vụ")">
                Thời vụ
            </option>
        </select>

        <button type="submit"
                class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
            Tìm kiếm
        </button>
    </form>

    <!-- TABLE -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-slate-600 uppercase text-xs font-bold border-b">
                    <tr>
                        <th class="px-6 py-4 text-center w-16">STT</th>
                        <th class="px-6 py-4">Nhân viên</th>
                        <th class="px-6 py-4">Loại</th>
                        <th class="px-6 py-4">Ngày ký</th>
                        <th class="px-6 py-4">Ngày kết thúc</th>
                        <th class="px-6 py-4">Lương</th>
                        <th class="px-6 py-4 text-center">Trạng thái</th>
                        <th class="px-6 py-4 text-right">Hành động</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr class="hover:bg-blue-50 transition-colors">

                                <td class="px-6 py-4 text-center text-slate-400">
                                    @(++stt)
                                </td>

                                <td class="px-6 py-4 font-semibold text-slate-700">
                                    @c.EmployeeName
                                </td>

                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700">
                                        @c.ContractType
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @c.StartDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="px-6 py-4 text-slate-500">
                                    @(c.EndDate.HasValue
                                        ? c.EndDate.Value.ToString("dd/MM/yyyy")
                                        : "—")
                                </td>

                                <td class="px-6 py-4 text-emerald-700 font-bold">
                                    @c.BasicSalary.ToString("N0") VNĐ
                                </td>

                                <td class="px-6 py-4 text-center">
                                    @if (c.IsActive)
                                    {
                                        <span class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold">
                                            Đang hiệu lực
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-full bg-slate-200 text-slate-600 text-xs font-bold">
                                            Hết hiệu lực
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-4 text-right">
                                    @if (c.IsActive)
                                    {
                                        <div class="flex justify-end items-center gap-2">

                                            <a href="/Contracts/Edit/@c.ContractId"
                                               class="flex items-center justify-center w-9 h-9 rounded-xl
                                               bg-blue-50 border border-blue-200 text-blue-600
                                               hover:bg-blue-600 hover:text-white transition-all">
                                                <i class="fa-solid fa-pen text-sm"></i>
                                            </a>

                                            <button type="button"
                                                    class="delete-btn flex items-center justify-center w-9 h-9
                                                    rounded-xl bg-red-50 border border-red-200 text-red-600
                                                    hover:bg-red-600 hover:text-white transition-all"
                                                    data-id="@c.ContractId">
                                                <i class="fa-solid fa-xmark text-sm"></i>
                                            </button>

                                        </div>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-6 text-slate-400">
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (totalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 mt-6">
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="px-3 py-1 rounded-lg bg-blue-600 text-white font-bold">
                        @i
                    </span>
                }
                else
                {
                    <a href="@Url.Action("Index", new {
                        page = i,
                        pageSize = pageSize,
                        isActive = isActive,
                        search = ViewBag.Search,
                        contractType = ViewBag.ContractType
                    })"
                       class="px-3 py-1 rounded-lg bg-white border hover:bg-blue-600 hover:text-white">
                        @i
                    </a>
                }
            }
        </div>
    }

</div>

<!-- CONFIRM MODAL -->
<div id="confirmModal"
     style="display:none;"
     class="fixed inset-0 bg-black/40 items-center justify-center z-50">

    <div class="bg-white rounded-xl shadow-lg w-96 p-6">
        <h2 class="text-lg font-semibold mb-4">Xác nhận</h2>
        <p class="text-slate-600 mb-6">
            Bạn có chắc muốn kết thúc hợp đồng này?
        </p>

        <div class="flex justify-end gap-3">
            <button id="cancelDelete"
                    class="px-4 py-2 bg-slate-200 rounded-lg">
                Hủy
            </button>

            <button id="confirmDelete"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<script>
    let contractIdToDelete = 0;

    const modal = document.getElementById("confirmModal");
    const confirmBtn = document.getElementById("confirmDelete");
    const cancelBtn = document.getElementById("cancelDelete");

    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            contractIdToDelete = this.getAttribute("data-id");
            modal.style.display = "flex";
        });
    });

    cancelBtn.addEventListener("click", function () {
        modal.style.display = "none";
    });

    modal.addEventListener("click", function (e) {
        if (e.target === modal) {
            modal.style.display = "none";
        }
    });

    confirmBtn.addEventListener("click", function () {

        const form = document.createElement("form");
        form.method = "POST";
        form.action = "/Contracts/Delete";

        form.innerHTML = `
            <input type="hidden" name="id" value="${contractIdToDelete}" />
            <input type="hidden" name="page" value="@currentPage" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <input type="hidden" name="isActive" value="@isActive.ToString().ToLower()" />
        `;

        document.body.appendChild(form);
        form.submit();
    });
</script>