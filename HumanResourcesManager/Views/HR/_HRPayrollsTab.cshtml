<div id="payrollsTab" class="tab-content hidden">
    <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-800">Bảng Lương Theo Tháng</h2>
                <p class="text-sm text-slate-500 mt-0.5">Tạo và xem bảng lương</p>
            </div>
            <div class="flex items-center gap-2">
                <input type="month" id="payrollMonthInput" class="px-3 py-2 border border-slate-200 rounded-xl text-sm">
                <button type="button" id="createPayrollBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2.5 rounded-xl shadow-sm text-sm">Tạo bảng lương tháng</button>
            </div>
        </div>
    </div>
    <div class="p-6">
        <div class="overflow-x-auto rounded-xl border border-slate-200/80">
            <table class="employee-table w-full">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Tháng</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Nhân viên</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Lương cơ bản</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Tăng ca</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Phạt</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Phụ cấp</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Thực lĩnh</th>
                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase">Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="payrollsTableBody"></tbody>
            </table>
        </div>
        <div id="payrollsPagination" class="pagination mt-6"></div>
    </div>
</div>
