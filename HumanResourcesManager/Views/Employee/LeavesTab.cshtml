@using HumanResourcesManager.BLL.DTOs.Employee
@using HumanResourcesManager.DAL.Enum
@using HumanResourcesManager.Helpers
@model EmployeeLeaveViewDTO
@{
	Layout = "~/Views/Employee/_EmployeeLayout.cshtml";
}

<!-- Main Content -->
<main class="flex-1 overflow-y-auto bg-slate-50/50">
	@await Html.PartialAsync("_EmployeeHeader")

	<div class="p-5 lg:p-8">
		@await Html.PartialAsync("_EmployeeStats")

		<!-- Tabs Content -->
		<div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
			<!-- Leaves Tab -->
			<div id="leavesTab" class="tab-content">
				<div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50">
                    <div class="flex flex-wrap items-start justify-between gap-4">

                        <!-- Title + Subtitle -->
                        <div>
                            <h2 class="text-xl font-bold text-slate-800 tracking-tight">
                                Nghỉ Phép
                            </h2>
                            <p class="text-sm text-slate-500 mt-1">
                                Quản lý đơn nghỉ phép và theo dõi trạng thái phê duyệt của bạn
                            </p>
                        </div>

                        <!-- Button -->
						<a asp-controller="Employee"
						   asp-action="CreateLeave"
						   class="group inline-flex items-center gap-2
          bg-gradient-to-r from-emerald-500 to-teal-500
          hover:from-emerald-600 hover:to-teal-600
          text-white px-5 py-2.5 rounded-xl text-sm font-semibold
          shadow-md hover:shadow-lg
          transition-all duration-200">

                            <!-- Icon calendar + plus (đẹp & đúng ngữ nghĩa hơn) -->
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-5 h-5 transition-transform duration-200 group-hover:scale-110"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M8 7V3m8 4V3m-9 8h6m-6 4h3m6-10H6a2 2 0 00-2 2v11a2 2 0 002 2h12a2 2 0 002-2V9a2 2 0 00-2-2z" />
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 14v4m2-2h-4" />
                            </svg>

                            Đăng Ký Nghỉ Phép
                        </a>

                    </div>
				</div>

                <div class="p-6">
                    <div class="max-w-6xl mx-auto">
                    </div>
                    <!-- FILTER -->
                    <form method="get"
                          class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm mb-8"
                          asp-action="Leaves">

                        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">

                            <!-- LEFT: Page Size -->
                            <div class="min-w-[160px]">
                                <label class="block text-xs text-slate-500 mb-1">Số dòng / trang</label>
                                <select name="pageSize"
                                        class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500">
                                    <option value="3" selected="@(Model.PageSize == 3)">3</option>
                                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                                </select>
                            </div>

                            <!-- RIGHT: Filters -->
                            <div class="flex flex-wrap items-end gap-4">

                                <!-- Year -->
                                <div class="min-w-[120px]">
                                    <label class="block text-xs text-slate-500 mb-1">Năm</label>
                                    <select name="year"
                                            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500">
                                        <option value="">Tất cả</option>
                                        @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                                        {
                                            <option value="@y" selected="@(Model.SelectedYear == y)">
                                                @y
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Status -->
                                <div class="min-w-[160px]">
                                    <label class="block text-xs text-slate-500 mb-1">Trạng thái</label>
                                    <select name="status"
                                            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500">
                                        <option value="">Tất cả</option>

                                        @foreach (var s in Enum.GetValues(typeof(HumanResourcesManager.DAL.Enum.RequestStatus)))
                                        {
                                            var statusValue = (RequestStatus)s;

                                            <option value="@statusValue"
                                                    selected="@(Model.SelectedStatus == statusValue)">
                                                @statusValue.ToDisplayName()
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Buttons -->
                                <div class="flex gap-3">
                                    <!-- Filter -->
                                    <button type="submit"
                                            class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium
                               bg-indigo-600 text-white hover:bg-indigo-700
                               transition shadow">

                                        <!-- Icon Funnel -->
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             class="w-4 h-4"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke="currentColor"
                                             stroke-width="2">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M3 4h18l-7 8v6l-4 2v-8L3 4z" />
                                        </svg>

                                        Lọc
                                    </button>

                                    <!-- Reset -->
                                    <a asp-action="Leaves"
                                       class="flex items-center justify-center w-11 h-11 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 transition shadow-sm">
                                        ↺
                                    </a>
                                </div>

                            </div>

                        </div>
                    </form>

                        <!-- TABLE -->
                        <div class="overflow-x-auto rounded-xl border border-slate-200/80">
						<table class="employee-table w-full">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200">
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase">STT</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Loại Phép</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Từ Ngày</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Đến Ngày</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                        Số Ngày<br />
                                        <span class="normal-case text-[11px] text-slate-400">
                                            (trừ T7, CN)
                                        </span>
                                    </th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Lý Do</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Trạng Thái</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase">
                                        Hành động
                                    </th>
								</tr>
							</thead>
                            <tbody>
                                @{
                                    int pageSize = Model.PageSize;
                                    int startIndex = (Model.CurrentPage - 1) * pageSize;
                                    int index = 0;
                                }

                                @if (Model.Records != null && Model.Records.Any())
                                {
                                    foreach (var item in Model.Records)
                                    {
                                        index++;

                                        <tr class="hover:bg-slate-50 transition">
                                            <td class="px-4 py-3 text-center text-slate-500 font-medium">
                                                @(startIndex + index)
                                            </td>
                                            <!-- Leave Type -->
                                            @{
                                                var leaveName = item.LeaveTypeName switch
                                                {
                                                    "Annual Leave" => "Nghỉ phép năm",
                                                    "Maternity Leave" => "Nghỉ thai sản",
                                                    _ => item.LeaveTypeName
                                                };
                                            }
                                            <td class="text-center px-4 py-3 font-medium text-slate-800">
                                        @leaveName
                                    </td>

                                            <!-- From Date -->
                                            <td class="text-center px-4 py-3">
                                                @item.FromDate.ToString("dd/MM/yyyy")
                                            </td>

                                            <!-- To Date -->
                                            <td class="text-center px-4 py-3">
                                                @item.ToDate.ToString("dd/MM/yyyy")
                                            </td>

                                            <!-- Total Days -->
                                            <td class="px-4 py-3 text-center">
                                                <span class="px-2 py-1 rounded-md text-xs font-medium bg-indigo-100 text-indigo-700">
                                                    @item.TotalDays
                                                </span>
                                            </td>

                                            <!-- Reason -->
                                            <td class="text-center px-4 py-3 text-slate-600 max-w-[220px] truncate" title="@item.Reason">
                                                @(string.IsNullOrWhiteSpace(item.Reason) ? "—" : item.Reason)
                                            </td>

                                            <!-- Status -->
                                            @{
                                                var statusText = item.Status switch
                                                {
                                                    RequestStatus.Pending => "Chờ duyệt",
                                                    RequestStatus.Approved => "Đã duyệt",
                                                    RequestStatus.Rejected => "Từ chối",
                                                    RequestStatus.Cancelled => "Đã huỷ",
                                                    _ => item.Status.ToString()
                                                };
                                            }
                                            <td class="px-4 py-3 text-center">
                                        <span class="inline-block px-3 py-1 text-xs font-medium rounded-full
    @(item.Status == RequestStatus.Pending ? "bg-yellow-100 text-yellow-700" :
                                                    item.Status == RequestStatus.Approved ? "bg-green-100 text-green-700" :
                                                    item.Status == RequestStatus.Rejected ? "bg-red-100 text-red-700" :
                                                    "bg-gray-200 text-gray-600")">
                                            @statusText
                                        </span>
                                    </td>
                                                                                                                    <td class="px-4 py-3">
                                                                                                                        <div class="flex justify-center items-center">
                                                                                                                            <form asp-action="CancelLeave" method="post">
                                                                                                                                <input type="hidden" name="id" value="@item.LeaveRequestId" />

                                                <button type="button"
                                                        onclick="confirmCancel(this)"
                                                        class="w-9 h-9 flex items-center justify-center rounded-lg transition
        @(item.Status == RequestStatus.Pending
                                                                        ? "bg-red-100 text-red-600 hover:bg-red-200"
                                                                        : "bg-slate-100 text-slate-300 cursor-not-allowed pointer-events-none")">

                                                    <!-- Trash Icon -->
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="w-4 h-4"
                                                         fill="none"
                                                         viewBox="0 0 24 24"
                                                         stroke="currentColor"
                                                         stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                              d="M6 7h12M9 7V4h6v3m-7 4v6m4-6v6M5 7h14l-1 13a2 2 0 01-2 2H8a2 2 0 01-2-2L5 7z" />
                                                    </svg>

                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                                                }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="py-10 text-center text-slate-400">
                                            Không có dữ liệu nghỉ phép
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>

                    <!-- Phân Trang -->
                    @if (Model.Records != null && Model.Records.Any() && Model.TotalPages > 1)
                        {
                            int currentPage = Model.CurrentPage;
                            int totalPages = Model.TotalPages;

                            <div class="flex justify-center mt-6 space-x-1">

                                <!-- Prev -->
                                <a asp-action="Leaves"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-year="@Model.SelectedYear"
                                   asp-route-status="@Model.SelectedStatus"
                                   class="px-3 py-1 border rounded-lg
               @(currentPage > 1 ? "bg-white hover:bg-slate-100" : "bg-slate-100 text-slate-400 pointer-events-none")">
                                    &lt;
                                </a>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <a asp-action="Leaves"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-year="@Model.SelectedYear"
                                       asp-route-status="@Model.SelectedStatus"
                                       class="px-3 py-1 border rounded-lg
                       @(i == currentPage ? "bg-indigo-600 text-white" : "bg-white hover:bg-slate-100")">
                                        @i
                                    </a>
                                }

                                <!-- Next -->
                                <a asp-action="Leaves"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-year="@Model.SelectedYear"
                                   asp-route-status="@Model.SelectedStatus"
                                   class="px-3 py-1 border rounded-lg
               @(currentPage < totalPages ? "bg-white hover:bg-slate-100" : "bg-slate-100 text-slate-400 pointer-events-none")">
                                    &gt;
                                </a>

                            </div>
                        }
					
					<div id="leavesPagination" class="pagination mt-6"></div>
				</div>
			</div>
		</div>
	</div>
</main>

@section Scripts {
	@if (TempData["Success"] != null)
	{
		<script>
			Swal.fire({
				toast: true,
				position: 'top-end',
				icon: 'success',
				title: @Html.Raw(Json.Serialize(TempData["Success"])),
				showConfirmButton: false,
				timer: 2500,
				timerProgressBar: true
			});
		</script>
	}

    <script>
        function confirmCancel(button) {
            Swal.fire({
                title: 'Bạn chắc chắn?',
                text: "Đơn nghỉ phép sẽ bị huỷ!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Huỷ đơn',
                cancelButtonText: 'Không',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // submit form
                    button.closest("form").submit();
                }
            });
        }
    </script>
}