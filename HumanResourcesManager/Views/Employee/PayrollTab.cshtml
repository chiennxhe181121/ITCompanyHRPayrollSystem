@using HumanResourcesManager.BLL.DTOs.Employee
@model EmployeePayrollViewDTO

@{
	Layout = "~/Views/Employee/_EmployeeLayout.cshtml";
}

<!-- Main Content -->
<main class="flex-1 overflow-y-auto bg-slate-50/50">
	@await Html.PartialAsync("_EmployeeHeader")

	<div class="p-5 lg:p-8">
		@await Html.PartialAsync("_EmployeeStats")

		<!-- Tabs Content -->
		<div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
			<!-- Payroll Tab -->
			<div id="payrollTab" class="tab-content">
                <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50">
                    <div class="flex flex-wrap items-start justify-between gap-4">

                        <!-- Title + Subtitle -->
                        <div>
                            <h2 class="text-xl font-bold text-slate-800 tracking-tight">
                                Lịch Sử Lương
                            </h2>
                            <p class="text-sm text-slate-500 mt-1">
                                Xem chi tiết lương hàng tháng, phụ cấp, tăng ca và các khoản khấu trừ
                            </p>
                        </div>

                    </div>
                </div>

				<div class="p-6">
                    <form method="get"
                          class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm mb-8"
                          asp-action="Payroll">

                        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">

                            <!-- LEFT -->
                            <div>
                                <label class="block text-xs text-slate-500 mb-1">Số dòng / trang</label>
                                <select name="pageSize" class="border rounded-lg px-3 py-2 text-sm">
                                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                                </select>
                            </div>

                            <!-- RIGHT -->
                            <div class="flex flex-wrap items-end gap-4">

                                <!-- Month -->
                                <div>
                                    <label class="block text-xs text-slate-500 mb-1">Tháng</label>
                                    <select name="month" class="border rounded-lg px-3 py-2 text-sm">
                                        <option value="">Tất cả</option>
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m" selected="@(Model.SelectedMonth == m)">
                                                Tháng @m
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Year -->
                                <div>
                                    <label class="block text-xs text-slate-500 mb-1">Năm</label>
                                    <select name="year" class="border rounded-lg px-3 py-2 text-sm">
                                        <option value="">Tất cả</option>
                                        @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                                        {
                                            <option value="@y" selected="@(Model.SelectedYear == y)">
                                                @y
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- Button -->
                                <div class="flex gap-3">
                                    <button type="submit"
                                            class="flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium
                               bg-indigo-600 text-white hover:bg-indigo-700 transition shadow">

                                        <!-- icon filter -->
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             class="w-4 h-4"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke="currentColor">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M3 4h18l-7 8v6l-4 2v-8L3 4z" />
                                        </svg>

                                        Lọc
                                    </button>

                                    <a asp-action="Payroll"
                                       class="flex items-center justify-center w-11 h-11 rounded-xl border border-slate-300 bg-white hover:bg-slate-100">
                                        ↺
                                    </a>
                                </div>

                            </div>

                        </div>
                    </form>

					<div class="overflow-x-auto rounded-xl border border-slate-200/80">
						<table class="employee-table w-full">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200">
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">STT</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Tháng</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Lương Cơ Bản</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Tăng Ca</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Phụ Cấp</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Phạt</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Thực Lĩnh</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Trạng Thái</th>
                                    <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Chi Tiết</th>
								</tr>
							</thead>
                            <tbody>
                                @{
                                    int startIndex = (Model.CurrentPage - 1) * Model.PageSize;
                                    int index = 0;
                                }

                                @if (Model.Records != null && Model.Records.Any())
                                {
                                    foreach (var item in Model.Records)
                                    {
                                        index++;
                                        <tr class="hover:bg-slate-50 transition">

                                            <td class="text-center px-4 py-3 text-slate-500">
                                                @(startIndex + index)
                                            </td>

                                            <td class="text-center px-4 py-3 font-medium">
                                                Tháng @item.Month/@item.Year
                                            </td>

                                            <td class="text-center px-4 py-3">
                                                @item.BasicSalary.ToString("N0") đ
                                            </td>

                                            <td class="text-center px-4 py-3 text-green-600">
                                                +@item.TotalOT.ToString("N0")
                                            </td>

                                            <td class="text-center px-4 py-3 text-blue-600">
                                                +@item.TotalAllowance.ToString("N0")
                                            </td>

                                            <td class="text-center px-4 py-3 text-red-500">
                                                -@item.MissingMinutesPenalty.ToString("N0")
                                            </td>

                                            <td class="text-center px-4 py-3 font-semibold text-indigo-600">
                                                @item.NetSalary.ToString("N0") đ
                                            </td>

                                            <!-- Status -->
                                            <td class="text-center px-4 py-3">
                                                <span class="px-3 py-1 text-xs rounded-full bg-green-100 text-green-700">
                                                    Đã chốt
                                                </span>
                                            </td>

                                            <!-- Action -->
                                            <td class="text-center px-4 py-3">
                                                <a asp-action="PayrollDetail"
                                                   asp-route-id="@item.PayrollId"
                                                   asp-route-month="@item.Month"
                                                   asp-route-year="@item.Year"
                                                   class="w-9 h-9 inline-flex items-center justify-center rounded-lg
                      bg-indigo-100 text-indigo-600 hover:bg-indigo-200 transition">

                                                    <!-- icon eye -->
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="w-4 h-4"
                                                         fill="none"
                                                         viewBox="0 0 24 24"
                                                         stroke="currentColor">
                                                        <path stroke-linecap="round"
                                                              stroke-linejoin="round"
                                                              stroke-width="2"
                                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round"
                                                              stroke-linejoin="round"
                                                              stroke-width="2"
                                                              d="M2.458 12C3.732 7.943 7.523 5 12 5
                             c4.477 0 8.268 2.943 9.542 7
                             -1.274 4.057-5.065 7-9.542 7
                             -4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="py-10 text-center text-slate-400">
                                            Không có dữ liệu bảng lương
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (Model.TotalPages > 1)
                        {
                            <div class="flex justify-center mt-6 space-x-1">

                                <a asp-action="Payroll"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-month="@Model.SelectedMonth"
                                   asp-route-year="@Model.SelectedYear"
                                   class="px-3 py-1 border rounded-lg
               @(Model.CurrentPage > 1 ? "bg-white" : "bg-slate-100 text-slate-400 pointer-events-none")">
                                    &lt;
                                </a>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <a asp-action="Payroll"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-month="@Model.SelectedMonth"
                                       asp-route-year="@Model.SelectedYear"
                                       class="px-3 py-1 border rounded-lg
                       @(i == Model.CurrentPage ? "bg-indigo-600 text-white" : "bg-white")">
                                        @i
                                    </a>
                                }

                                <a asp-action="Payroll"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-month="@Model.SelectedMonth"
                                   asp-route-year="@Model.SelectedYear"
                                   class="px-3 py-1 border rounded-lg
               @(Model.CurrentPage < Model.TotalPages ? "bg-white" : "bg-slate-100 text-slate-400 pointer-events-none")">
                                    &gt;
                                </a>
                            </div>
                        }
					</div>
				</div>
			</div>
		</div>
	</div>
</main>