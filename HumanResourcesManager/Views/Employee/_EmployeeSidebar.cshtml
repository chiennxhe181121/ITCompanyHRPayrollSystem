@* Employee Sidebar *@
@using HumanResourcesManager.BLL.DTOs
@using HumanResourcesManager.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var user = HttpContextAccessor.HttpContext?.Session.GetObject<UserSessionDTO>("USER_SESSION");
    var roleCode = (user?.RoleCode ?? string.Empty).ToUpperInvariant();
    var canBackToRolePage = roleCode == "MANAGER" || roleCode == "HR";
    var roleHomeUrl = roleCode == "MANAGER"
        ? "/HumanResourcesManager/manager/profile"
        : "/HumanResourcesManager/hr/employees";

    // Hàm check active đồng bộ với logic Admin
    string IsActive(params string[] actions)
    {
        return actions.Contains(currentAction) ? "active" : "";
    }
}

<aside class="employee-sidebar w-72 bg-white border-r border-slate-200 flex-shrink-0 h-screen sticky top-0 hidden lg:block shadow-[4px_0_24px_rgba(0,0,0,0.02)] z-30">
    <div class="h-full flex flex-col justify-between">

        <div>
            <div class="h-16 flex items-center px-6 border-b border-slate-100">
                <div class="flex items-center gap-2 text-indigo-700 font-extrabold text-xl tracking-tight">
                    <i class="fa-solid fa-layer-group text-2xl"></i>
                    <span>HRM System</span>
                </div>
            </div>

            <div class="p-5">
                <div class="flex items-center gap-4 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                    <div class="relative flex-shrink-0">
                        @if (ViewBag.HasAvatar == true)
                        {
                            <img src="@Url.Content(ViewBag.SidebarUserAvatar)"
                                 alt="Avatar"
                                 class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-md shadow-indigo-200" />
                        }
                        else
                        {
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center font-bold shadow-md shadow-indigo-200 border-2 border-white">
                                @ViewBag.SidebarUserAvatarInitial
                            </div>
                        }
                        <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full"></span>
                    </div>

                    <div class="overflow-hidden">
                        <p class="font-bold text-slate-800 text-sm truncate" id="sidebarUserName">
                            @ViewBag.SidebarUserName
                        </p>
                        <p class="text-xs text-slate-500 font-medium truncate mt-0.5" id="sidebarUserPosition">
                            @ViewBag.SidebarUserPosition
                        </p>
                    </div>
                </div>
            </div>

            <nav class="px-4 space-y-6 overflow-y-auto custom-scrollbar" style="max-height: calc(100vh - 220px);">

                <div>
                    <p class="px-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Cá nhân & Công việc</p>
                    <div class="space-y-1">

                        <a asp-controller="Employee" asp-action="Profile"
                           class="nav-item @IsActive("Profile", "ChangePassword")">
                            <span class="nav-icon"><i class="fa-solid fa-user-tie"></i></span>
                            <span class="font-medium">Hồ Sơ</span>
                        </a>

                        <a asp-controller="Employee" asp-action="Index"
                           class="nav-item @IsActive("Index", "History")">
                            <span class="nav-icon"><i class="fa-solid fa-calendar-check"></i></span>
                            <span class="font-medium">Chấm Công</span>
                        </a>

                        <a asp-controller="Employee" asp-action="Leaves"
                           class="nav-item @IsActive("Leaves", "CreateLeave")">
                            <span class="nav-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
                            <span class="font-medium">Nghỉ Phép</span>
                        </a>

                        <a asp-controller="Employee" asp-action="Overtime"
                           class="nav-item @IsActive("Overtime", "OTAttendance")">
                            <span class="nav-icon"><i class="fa-solid fa-clock"></i></span>
                            <span class="font-medium">Tăng Ca</span>
                        </a>

                        <a asp-controller="Employee" asp-action="Payroll"
                           class="nav-item @IsActive("Payroll", "PayrollDetail")">
                            <span class="nav-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
                            <span class="font-medium">Bảng Lương</span>
                        </a>

                        @if (canBackToRolePage)
                        {
                            <a href="@roleHomeUrl" class="nav-item">
                                <span class="nav-icon"><i class="fa-solid fa-arrow-left"></i></span>
                                <span class="font-medium">Quay lại trang role</span>
                            </a>
                        }

                    </div>
                </div>

            </nav>
        </div>

        <div class="p-4 border-t border-slate-100 bg-slate-50/50">
            <button type="button" onclick="document.getElementById('logoutForm').submit()"
                    class="group flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-red-50 hover:text-red-600 hover:border-red-100 transition-all duration-200 shadow-sm">
                <i class="fa-solid fa-arrow-right-from-bracket transition-transform group-hover:-translate-x-1"></i>
                <span>Đăng xuất</span>
            </button>
            <form id="logoutForm" method="get" action="/HumanResourcesManager/logout" class="hidden"></form>
        </div>
    </div>
</aside>

<style>
    /* CSS đồng bộ hoàn toàn với bản Admin */
    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        border-radius: 12px;
        color: #64748b;
        transition: all 0.2s ease-in-out;
        font-size: 0.875rem;
    }

        .nav-item .nav-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            font-size: 1.1rem;
            transition: transform 0.2s;
        }

        .nav-item:hover {
            background-color: #f1f5f9;
            color: #4f46e5;
        }

            .nav-item:hover .nav-icon {
                transform: translateX(3px);
            }

        .nav-item.active {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            font-weight: 600;
        }

            .nav-item.active .nav-icon {
                color: rgba(255,255,255,0.9);
            }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 20px;
    }
</style>