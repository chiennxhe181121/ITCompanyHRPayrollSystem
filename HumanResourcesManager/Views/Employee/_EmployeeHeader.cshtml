@* Employee Header *@
<header class="employee-header px-6 lg:px-8 py-5">
	<div class="flex flex-wrap items-center justify-between gap-4">
		<div>
			<h1 class="text-2xl font-semibold text-slate-800">Bảng điều khiển nhân viên</h1>
			<p class="text-slate-500 text-sm mt-0.5">Chấm công và quản lý thông tin cá nhân</p>
		</div>

		<div class="clock-box">
			<div class="text-right">
				<p class="clock-date-label" id="currentDateLabel"></p>
				<p class="clock-date-value" id="currentDate"></p>
			</div>
			<p class="clock-time" id="currentTime"></p>
		</div>
	</div>
</header>
