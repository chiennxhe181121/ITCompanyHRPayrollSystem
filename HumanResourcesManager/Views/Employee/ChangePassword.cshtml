@using HumanResourcesManager.BLL.DTOs.Employee
@model ChangePasswordDTO;

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Employee/_EmployeeLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">

<main class="flex-1 overflow-y-auto bg-[#f8fafc] font-['Plus_Jakarta_Sans',_sans-serif]">
    @await Html.PartialAsync("_EmployeeHeader")

    <div class="p-5 lg:p-12 flex justify-center">
        <div class="w-full max-w-xl bg-white rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-200/60 overflow-hidden">

            <div class="px-8 py-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-sm border border-slate-100">
                        <i class="bi bi-shield-lock-fill text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-800 tracking-tight">
                            Đổi mật khẩu
                        </h2>
                        <p class="text-[13px] text-slate-500 font-medium">
                            Cập nhật định kỳ để bảo vệ tài khoản
                        </p>
                    </div>
                </div>

                <a asp-area="HumanResourcesManager"
                   asp-controller="Employee"
                   asp-action="Profile"
                   class="group inline-flex items-center gap-2 px-4 py-2 rounded-xl text-[13px] font-bold border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-all duration-300">
                    <i class="bi bi-arrow-left transition-transform group-hover:-translate-x-1"></i>
                    Quay lại
                </a>
            </div>

            <div class="p-8 md:p-10">
                @if (TempData["Success"] != null)
                {
                    <div class="mb-8 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-[13px] font-bold flex items-center gap-3">
                        <i class="bi bi-check-circle-fill text-lg"></i>
                        @TempData["Success"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-8 p-4 rounded-2xl bg-red-50 border border-red-100 shadow-sm">
                        <div class="flex items-start gap-3">
                            <i class="bi bi-exclamation-circle-fill text-red-500 text-lg"></i>
                            <div class="text-[13px] text-red-700">
                                <p class="font-bold mb-1">Có lỗi xảy ra:</p>
                                <ul class="list-disc list-inside space-y-1 opacity-90">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <form method="post" asp-action="ChangePassword" class="space-y-8">
                    @Html.AntiForgeryToken()

                    <div class="space-y-2.5">
                        <label class="block text-[11px] font-extrabold text-slate-400 uppercase tracking-widest ml-1">
                            Mật khẩu hiện tại
                        </label>
                        <div class="relative group">
                            <input asp-for="CurrentPassword" id="CurrentPassword"
                                   type="password"
                                   autocomplete="current-password"
                                   class="custom-input pl-11 pr-12"
                                   placeholder="••••••••" />
                            <i class="bi bi-key-fill absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-indigo-500 transition-colors"></i>

                            <button type="button" onclick="togglePassword('CurrentPassword', this)"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 transition-colors">
                                <i class="bi bi-eye text-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs font-medium mt-1 block ml-1"></span>
                    </div>

                    <div class="space-y-2.5">
                        <label class="block text-[11px] font-extrabold text-slate-400 uppercase tracking-widest ml-1">
                            Mật khẩu mới
                        </label>
                        <div class="relative group">
                            <input asp-for="NewPassword" id="NewPassword" required
                                   type="password"
                                   autocomplete="new-password"
                                   class="custom-input pl-11 pr-12"
                                   placeholder="Nhập mật khẩu mới" />
                            <i class="bi bi-shield-lock-fill absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-indigo-500 transition-colors"></i>

                            <button type="button" onclick="togglePassword('NewPassword', this)"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 transition-colors">
                                <i class="bi bi-eye text-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-red-500 text-xs font-medium mt-1 block ml-1"></span>

                        <div class="flex items-start gap-2.5 p-3.5 bg-indigo-50/50 rounded-xl border border-indigo-100/50 mt-3">
                            <i class="bi bi-info-circle-fill text-indigo-500 text-xs mt-0.5"></i>
                            <p class="text-[11px] text-indigo-700/70 leading-relaxed font-medium">
                                Mật khẩu cần ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2.5">
                        <label class="block text-[11px] font-extrabold text-slate-400 uppercase tracking-widest ml-1">
                            Xác nhận mật khẩu mới
                        </label>
                        <div class="relative group">
                            <input asp-for="ConfirmPassword" id="ConfirmPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   class="custom-input pl-11 pr-12"
                                   placeholder="Nhập lại mật khẩu mới" />

                            <i class="bi bi-shield-check-fill absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-indigo-500 transition-colors"></i>

                            <button type="button" onclick="togglePassword('ConfirmPassword', this)"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 transition-colors">
                                <i class="bi bi-eye text-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs font-medium mt-1 block ml-1"></span>
                    </div>

                    <div class="pt-6 flex flex-col sm:flex-row gap-4">
                        <button type="submit"
                                class="flex-1 inline-flex items-center justify-center gap-2 px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white text-[14px] font-extrabold rounded-2xl shadow-xl shadow-indigo-100 transition-all active:scale-95">
                            <i class="bi bi-check-lg"></i>
                            Lưu mật khẩu
                        </button>

                        <a asp-controller="Employee"
                           asp-action="Profile"
                           class="inline-flex items-center justify-center px-8 py-4 rounded-2xl text-[14px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition-all">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<style>
    .custom-input {
        @@apply w-full py-4 rounded-2xl bg-white border border-slate-200 text-slate-800 font-semibold text-[14px] transition-all duration-300 outline-none shadow-sm;
    }

        .custom-input:focus {
            @@apply border-indigo-500 ring-4 ring-indigo-500/10;
        }

        .custom-input::placeholder {
            @@apply text-slate-300 font-normal;
        }
</style>

<script>
    function togglePassword(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector("i");

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash"); // Hiện text thì gạch mắt
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye"); // Ẩn text thì hiện mắt
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}