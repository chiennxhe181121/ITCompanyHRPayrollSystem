@using HumanResourcesManager.BLL.DTOs.Employee
@using HumanResourcesManager.DAL.Enum
@model EmployeePayrollDetailDTO
@{
    ViewData["Title"] = "Chi tiết lương tháng " + Model.Month + "/" + Model.Year;
    Layout = "~/Views/Employee/_EmployeeLayout.cshtml";
}

<main class="flex-1 overflow-y-auto bg-slate-50/50 font-['Plus_Jakarta_Sans',_sans-serif]">
    @await Html.PartialAsync("_EmployeeHeader")

    <div class="p-5 lg:p-8">
        <div class="max-w-2xl mx-auto">

            <div class="mb-6">
                <a asp-action="Payroll"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:text-indigo-600 hover:bg-white transition-all">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại lịch sử lương
                </a>
            </div>

            <div class="bg-white rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100 overflow-hidden relative">

                <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full -mr-16 -mt-16"></div>

                <div class="p-8 md:p-12">
                    <div class="text-center mb-10">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-200 mb-4">
                            <i class="bi bi-wallet2 text-2xl"></i>
                        </div>
                        <h2 class="text-2xl font-extrabold text-slate-800 tracking-tight">Phiếu Lương Chi Tiết</h2>
                        <p class="text-slate-500 font-medium mt-1">Kỳ lương tháng @Model.Month năm @Model.Year</p>
                    </div>

                    <div class="space-y-6">

                        <div class="bg-slate-50/50 rounded-2xl p-5 border border-slate-100">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500 font-bold uppercase text-[11px] tracking-widest">Mức lương thỏa thuận</span>
                                <span class="text-lg font-bold text-slate-800">@Model.BasicSalary.ToString("N0") <span class="text-sm font-medium text-slate-400">đ</span></span>
                            </div>
                        </div>

                        <div class="px-2 space-y-4">
                            <h3 class="text-[12px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-50 pb-2">Chi tiết biến động</h3>

                            <div class="space-y-3">
                                @foreach (var d in Model.Details)
                                {
                                    var isPositive = d.Type != PayrollDetailType.Deduction;
                                    <div class="flex justify-between items-center group">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg flex items-center justify-center @(isPositive ? "bg-emerald-50 text-emerald-600" : "bg-red-50 text-red-500")">
                                                <i class="bi @(isPositive ? "bi-plus-circle-fill" : "bi-dash-circle-fill") text-xs"></i>
                                            </div>
                                            <span class="text-sm font-semibold text-slate-600 group-hover:text-slate-900 transition-colors">@d.Description</span>
                                        </div>
                                        <span class="text-sm font-bold @(isPositive ? "text-emerald-600" : "text-red-500")">
                                            @(isPositive ? "+" : "-") @d.Amount.ToString("N0") đ
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="relative py-4">
                            <div class="absolute inset-0 flex items-center" aria-hidden="true">
                                <div class="w-full border-t border-dashed border-slate-200"></div>
                            </div>
                        </div>

                        <div class="bg-indigo-600 rounded-3xl p-6 shadow-xl shadow-indigo-100 relative overflow-hidden">
                            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 16px 16px;"></div>

                            <div class="relative flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
                                <div>
                                    <p class="text-indigo-100 text-xs font-bold uppercase tracking-widest mb-1">Tổng thu nhập thực nhận</p>
                                    <h4 class="text-3xl font-black text-white">@Model.NetSalary.ToString("N0") <span class="text-lg font-medium opacity-80">đ</span></h4>
                                </div>
                                @* <div class="px-4 py-2 bg-white/20 backdrop-blur-md rounded-xl border border-white/20">
                                    <span class="text-white text-xs font-bold italic">@NumberToText(Model.NetSalary) đồng</span>
                                </div> *@
                            </div>
                        </div>

                    </div>

                    <div class="mt-10 text-center">
                        <p class="text-slate-400 text-xs font-medium italic">
                            * Mọi thắc mắc về bảng lương vui lòng liên hệ phòng Nhân sự trước ngày 05 hàng tháng.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-8 flex justify-center">
                <button onclick="window.print()" class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
                    <i class="bi bi-printer"></i> In phiếu lương
                </button>
            </div>
        </div>
    </div>
</main>

@functions {
    // Hàm đọc số tiền bằng chữ (Gợi ý)
    public string NumberToText(decimal number)
    {
        // Bạn có thể viết logic đọc số tiền tại đây hoặc để trống
        return "Mười triệu tám trăm nghìn";
    }
}