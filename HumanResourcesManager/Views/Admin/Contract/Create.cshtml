@model HumanResourcesManager.BLL.DTOs.ContractDTO

@{
    ViewData["Title"] = "Tạo Hợp Đồng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Đã đổi sang layout Admin
}

<div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
        <div class="absolute top-10 right-10 w-72 h-72 rounded-full bg-blue-200/40 mix-blend-multiply filter blur-3xl animate-blob"></div>
        <div class="absolute bottom-10 left-10 w-72 h-72 rounded-full bg-indigo-200/40 mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 sm:mx-auto sm:w-full sm:max-w-2xl animate__animated animate__fadeInUp">

        <a href="/HumanResourcesManager/admin/contracts" class="inline-flex items-center text-sm text-slate-500 hover:text-blue-600 mb-6 transition-colors group">
            <i class="fa-solid fa-arrow-left-long mr-2 transition-transform group-hover:-translate-x-1"></i> Quay lại danh sách
        </a>

        <div class="bg-white shadow-2xl rounded-3xl overflow-hidden border border-slate-100">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-8 text-white relative">
                <div class="relative z-10">
                    <h2 class="text-2xl font-extrabold tracking-tight">Thiết Lập Hợp Đồng</h2>
                    <p class="mt-1 text-blue-100 text-xs opacity-90">Khởi tạo hợp đồng lao động mới cho nhân viên.</p>
                </div>
                <i class="fa-solid fa-file-signature absolute right-6 top-1/2 -translate-y-1/2 text-6xl opacity-10 rotate-12"></i>
            </div>

            <form asp-action="Create" method="post" class="p-8 space-y-6">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-red-500 text-sm font-medium bg-red-50 p-3 rounded-lg hidden"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label asp-for="EmployeeId" class="block text-xs font-bold text-slate-500 uppercase mb-2">Nhân viên <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 z-10"></i>
                            <select asp-for="EmployeeId" asp-items="Model.Employees" class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-bold text-slate-700 appearance-none cursor-pointer">
                                <option value="">-- Chọn nhân viên --</option>
                            </select>
                            <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                        </div>
                        <span asp-validation-for="EmployeeId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="ContractType" class="block text-xs font-bold text-slate-500 uppercase mb-2">Loại hợp đồng <span class="text-red-500">*</span></label>
                        <div class="relative flex gap-4">
                            <label class="flex-1 flex items-center justify-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-indigo-50 transition-colors has-[:checked]:bg-indigo-100 has-[:checked]:border-indigo-500 has-[:checked]:text-indigo-700">
                                <input type="radio" asp-for="ContractType" value="Thử việc" class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <span class="text-sm font-bold">Thử việc</span>
                            </label>
                            <label class="flex-1 flex items-center justify-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-emerald-50 transition-colors has-[:checked]:bg-emerald-100 has-[:checked]:border-emerald-500 has-[:checked]:text-emerald-700">
                                <input type="radio" asp-for="ContractType" value="Chính thức" class="w-4 h-4 text-emerald-600 border-gray-300 focus:ring-emerald-500">
                                <span class="text-sm font-bold">Chính thức</span>
                            </label>
                            <label class="flex-1 flex items-center justify-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-amber-50 transition-colors has-[:checked]:bg-amber-100 has-[:checked]:border-amber-500 has-[:checked]:text-amber-700">
                                <input type="radio" asp-for="ContractType" value="Thời vụ" class="w-4 h-4 text-amber-600 border-gray-300 focus:ring-amber-500">
                                <span class="text-sm font-bold">Thời vụ</span>
                            </label>
                        </div>
                        <span asp-validation-for="ContractType" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="StartDate" class="block text-xs font-bold text-slate-500 uppercase mb-2">Ngày bắt đầu <span class="text-red-500">*</span></label>
                        <input asp-for="StartDate" type="date" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-700" />
                        <span asp-validation-for="StartDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="EndDate" class="block text-xs font-bold text-slate-500 uppercase mb-2">Ngày kết thúc (Để trống = Vô thời hạn)</label>
                        <input asp-for="EndDate" type="date" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-slate-700" />
                        <span asp-validation-for="EndDate" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="BasicSalary" class="block text-xs font-bold text-slate-500 uppercase mb-2">Lương cơ bản (VNĐ) <span class="text-red-500">*</span></label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-solid fa-money-bill text-slate-400 group-focus-within:text-blue-500 transition-colors"></i>
                            </div>
                            <input type="text" id="salaryDisplay"
                                   class="block w-full pl-11 pr-14 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition-all font-mono font-bold text-blue-700"
                                   placeholder="0" oninput="formatCurrency(this)" maxlength="19" autocomplete="off" />
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <span class="text-slate-400 font-bold text-xs">VNĐ</span>
                            </div>
                            <input asp-for="BasicSalary" type="hidden" id="salaryHidden" />
                        </div>
                        <p id="salaryText" class="text-[11px] text-blue-600 font-medium ml-1 italic mt-1 min-h-[1rem]"></p>
                        <span asp-validation-for="BasicSalary" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-6 border-t border-slate-100 mt-4">
                    <a href="/HumanResourcesManager/admin/contracts" class="flex-1 py-3 text-center rounded-xl border border-slate-200 text-slate-500 text-sm font-bold hover:bg-slate-50 transition-all">Huỷ bỏ</a>
                    <button type="submit" class="flex-[2] py-3 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-200 hover:shadow-blue-300 transition-all transform hover:-translate-y-0.5">
                        <i class="fa-solid fa-file-contract mr-1"></i> Khởi tạo hợp đồng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const DOCSO={chuSo:["không","một","hai","ba","bốn","năm","sáu","bảy","tám","chín"],tien:["","nghìn","triệu","tỷ","nghìn tỷ"],doc3so:function(n){let t=Math.floor(n/100),o=Math.floor(n%100/10),e=n%10,u="";return 0==t&&0==o&&0==e?"":(0!=t&&(u+=this.chuSo[t]+" trăm ",0==o&&0!=e&&(u+="linh ")),0!=o&&1!=o&&(u+=this.chuSo[o]+" mươi ",0==o&&0!=e&&(u+="linh ")),1==o&&(u+="mười "),1==e?o>1?u+="mốt ":u+=this.chuSo[e]:5==e?0==o?u+=this.chuSo[e]:u+="lăm ":0!=e&&(u+=this.chuSo[e]),u)},doc:function(n){if(0===n)return"Không đồng";let t=0,o=0,e="",u=[];if(n<0)return"Số âm";for(;n>0;)u[t]=n%1e3,n=Math.floor(n/1e3),t++;for(o=t-1;o>=0;o--)0!=u[o]&&(e+=this.doc3so(u[o])+" "+this.tien[o]+" ");return e.replace(/\s+/g," ").trim()}};function formatCurrency(n){let t=n.value.replace(/[^0-9]/g,"");t.length>15&&(t=t.substring(0,15)),document.getElementById("salaryHidden").value=t,t?(n.value=new Intl.NumberFormat("en-US").format(t),!isNaN(parseInt(t,10))&&(document.getElementById("salaryText").innerText="Bằng chữ: "+(o=DOCSO.doc(parseInt(t,10))).charAt(0).toUpperCase()+o.slice(1)+" đồng")):(n.value="",document.getElementById("salaryText").innerText="");var o}

        // Kích hoạt ngay nếu có lỗi validation trả về giá trị cũ
        document.addEventListener("DOMContentLoaded", function() {
            const sum = document.querySelector(".validation-summary-errors");
            if(sum && sum.innerText.trim() !== "") sum.classList.remove("hidden");

            const input = document.getElementById('salaryDisplay');
            if(input && document.getElementById('salaryHidden').value) {
                input.value = document.getElementById('salaryHidden').value;
                formatCurrency(input);
            }
        });
    </script>
    <style>
        @@keyframes blob {
            0% {
                transform: translate(0, 0) scale(1);
            }

            33% {
                transform: translate(30px, -50px) scale(1.1);
            }

            66% {
                transform: translate(-20px, 20px) scale(0.9);
            }

            100% {
                transform: translate(0, 0) scale(1);
            }
        }

        .animate-blob {
            animation: blob 7s infinite;
        }

        .animation-delay-2000 {
            animation-delay: 2s;
        }
    </style>
}